# The Jev key. Read by the hook only, never passed to a git child process.
TYPESAFE_API_KEY=

# Optional: an alias for the same key.
# JEV_API_KEY=

# Optional: a local gateway shim speaking the direct wire format.
# JEV_BASE_URL=http://127.0.0.1:4322

# Optional: plain text report, no color and no spinner.
# NO_COLOR=1
